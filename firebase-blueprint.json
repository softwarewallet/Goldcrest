{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account settings and trading preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "tradingMode": { "type": "string" },
        "riskPerTradePct": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PaperPortfolio": {
      "title": "Paper Portfolio",
      "description": "Paper trading account balance and equity state across USD and INR",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "equity": { "type": "number" },
        "usdBalance": { "type": "number" },
        "inrBalance": { "type": "number" },
        "marginUsed": { "type": "number" },
        "freeMargin": { "type": "number" },
        "currency": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PaperTrade": {
      "title": "Paper Trade",
      "description": "Executed paper trade record with native-currency accounting and FX conversion reporting",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "symbol": { "type": "string" },
        "market": { "type": "string" },
        "type": { "type": "string" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "pnl": { "type": "number" },
        "nativeCurrency": { "type": "string", "enum": ["USD", "INR"] },
        "nativeGrossPnL": { "type": "number" },
        "nativeCosts": { "type": "number" },
        "nativeNetPnL": { "type": "number" },
        "reportingCurrency": { "type": "string", "enum": ["USD", "INR"] },
        "fxRate": { "type": "number" },
        "fxRateTimestamp": { "type": "number" },
        "fxRateSource": { "type": "string" },
        "conversionMethodology": { "type": "string" },
        "conversionVersion": { "type": "string" },
        "convertedAmount": { "type": "number" },
        "status": { "type": "string" },
        "openedAt": { "type": "string", "format": "date-time" },
        "closedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PaperSignalTracked": {
      "title": "Paper Signal Tracked",
      "description": "Tracked paper signals",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "pair": { "type": "string" },
        "direction": { "type": "string" },
        "entryPrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "stopLoss": { "type": "number" },
        "tp1": { "type": "number" },
        "tp2": { "type": "number" },
        "tp3": { "type": "number" },
        "unrealizedPnlPips": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "TradeTrace": {
      "title": "Trade Trace",
      "description": "Immutable trade trace root linking all 14 execution lifecycle stages",
      "type": "object",
      "properties": {
        "tradeTraceId": { "type": "string" },
        "signalId": { "type": "string" },
        "environment": { "type": "string", "enum": ["PAPER", "DEMO", "SANDBOX", "LIVE"] },
        "broker": { "type": "string" },
        "marketDataSnapshotId": { "type": "string" },
        "featureSnapshotId": { "type": "string" },
        "deterministicAnalysisId": { "type": "string" },
        "mlPredictionId": { "type": "string" },
        "decisionFusionState": { "type": "string" },
        "riskDecisionId": { "type": "string" },
        "orderProposalId": { "type": "string" },
        "brokerOrderId": { "type": "string" },
        "fillIds": { "type": "array" },
        "positionId": { "type": "string" },
        "exitIds": { "type": "array" },
        "tradeOutcomeId": { "type": "string" },
        "researchRecordId": { "type": "string" },
        "datasetVersion": { "type": "string" },
        "strategyVersion": { "type": "string" },
        "modelVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "EXECUTED", "RECONCILED", "RECONCILIATION_MISMATCH", "FAILED"] },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tradeTraceId", "signalId", "environment", "status"]
    },
    "TradeTraceNode": {
      "title": "Trade Trace Lifecycle Node",
      "description": "Individual node in the 14-stage execution trace chain",
      "type": "object",
      "properties": {
        "nodeId": { "type": "string" },
        "tradeTraceId": { "type": "string" },
        "nodeType": { "type": "string" },
        "environment": { "type": "string" },
        "broker": { "type": "string" },
        "payload": { "type": "object" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["nodeId", "tradeTraceId", "nodeType"]
    },
    "ReconciliationRecord": {
      "title": "Reconciliation Record",
      "description": "3-Way reconciliation check between Internal, Broker, and Cloud Firestore states",
      "type": "object",
      "properties": {
        "reconciliationId": { "type": "string" },
        "tradeTraceId": { "type": "string" },
        "status": { "type": "string", "enum": ["MATCHED", "RECONCILIATION_MISMATCH", "ORPHAN_INTERNAL", "ORPHAN_BROKER", "ORPHAN_CLOUD", "CLOUDDIVERGENCE"] },
        "internalState": { "type": "object" },
        "brokerState": { "type": "object" },
        "firestoreState": { "type": "object" },
        "discrepancies": { "type": "array" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["reconciliationId", "tradeTraceId", "status"]
    },
    "AuditEvent": {
      "title": "Audit Event",
      "description": "Redacted security and execution audit logs",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "tradeTraceId": { "type": "string" },
        "eventType": { "type": "string" },
        "environment": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["eventId", "eventType"]
    },
    "HistoricalReportSnapshot": {
      "title": "Historical Report Snapshot",
      "description": "Persisted reproducible report snapshot with complete FX conversion metadata",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "reportPeriod": { "type": "string" },
        "reportingCurrency": { "type": "string", "enum": ["USD", "INR"] },
        "conversionMethodology": { "type": "string" },
        "conversionVersion": { "type": "string" },
        "fxRecordsUsed": { "type": "array" },
        "nativeSubtotals": { "type": "object" },
        "convertedSubtotals": { "type": "object" },
        "consolidatedTotals": { "type": "object" },
        "generatedAt": { "type": "number" }
      },
      "required": ["reportId", "reportingCurrency", "conversionVersion"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "paper_portfolios/{portfolioId}": {
      "schema": "PaperPortfolio",
      "description": "Paper portfolio collection"
    },
    "paper_trades/{tradeId}": {
      "schema": "PaperTrade",
      "description": "Paper trades collection"
    },
    "paper_signals_tracked/{signalId}": {
      "schema": "PaperSignalTracked",
      "description": "Tracked paper signals"
    },
    "trade_traces/{tradeTraceId}": {
      "schema": "TradeTrace",
      "description": "Trade traces collection"
    },
    "trade_traces/{tradeTraceId}/nodes/{nodeId}": {
      "schema": "TradeTraceNode",
      "description": "Trade trace lifecycle nodes subcollection"
    },
    "reconciliation_records/{reconciliationId}": {
      "schema": "ReconciliationRecord",
      "description": "Reconciliation records collection"
    },
    "audit_events/{eventId}": {
      "schema": "AuditEvent",
      "description": "Audit logs collection"
    },
    "historical_report_snapshots/{snapshotId}": {
      "schema": "HistoricalReportSnapshot",
      "description": "Persisted report snapshots collection"
    }
  }
}
