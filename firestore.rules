rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Deny by default. Sensitive operational, audit, model, reconciliation,
    // and system collections are server-only through the Admin SDK/backend.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User-scoped application data. Documents must carry an ownerId equal to
    // the authenticated user's UID for both reads and writes.
    match /paper_portfolios/{portfolioId} {
      allow read, write: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    match /paper_trades/{tradeId} {
      allow read, write: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    match /paper_signals_tracked/{trackingId} {
      allow read, write: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    match /watchlists/{watchlistId} {
      allow read, write: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    match /trade_notes/{noteId} {
      allow read, write: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    // All other collections, including trade traces, reconciliation,
    // audit events, system settings, historical snapshots, and ML storage,
    // remain server-only. The Admin SDK is not governed by these client rules.
  }
}
