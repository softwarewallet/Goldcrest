# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Phase 2B: Broker Integration Credentials & Safety Controls

# cTrader Demo Environment
CTRADER_DEMO_CLIENT_ID=""
CTRADER_DEMO_CLIENT_SECRET=""
CTRADER_DEMO_ACCESS_TOKEN=""
CTRADER_DEMO_ACCOUNT_ID=""

# cTrader Live Environment
CTRADER_LIVE_CLIENT_ID=""
CTRADER_LIVE_CLIENT_SECRET=""
CTRADER_LIVE_ACCESS_TOKEN=""
CTRADER_LIVE_ACCOUNT_ID=""

# 5paisa Demo Environment (OpenAPI / Sandbox)
FIVEPAISA_DEMO_APP_NAME=""
FIVEPAISA_DEMO_APP_SOURCE=""
FIVEPAISA_DEMO_USER_ID=""
FIVEPAISA_DEMO_PASSWORD=""
FIVEPAISA_DEMO_USER_KEY=""
FIVEPAISA_DEMO_ENCRYPTION_KEY=""
FIVEPAISA_DEMO_CLIENT_CODE=""

# 5paisa Live Environment (OpenAPI / Production)
FIVEPAISA_LIVE_APP_NAME=""
FIVEPAISA_LIVE_APP_SOURCE=""
FIVEPAISA_LIVE_USER_ID=""
FIVEPAISA_LIVE_PASSWORD=""
FIVEPAISA_LIVE_USER_KEY=""
FIVEPAISA_LIVE_ENCRYPTION_KEY=""
FIVEPAISA_LIVE_CLIENT_CODE=""

# Safety Controls (Default to false / off)
LIVE_CONNECTION_ENABLED="false"
LIVE_TRADING_ENABLED="false"
AUTO_EXECUTION_ENABLED="false"

