# Goldcrest production runtime
NODE_ENV="production"
HOST="0.0.0.0"
PORT="3000"
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY="false"

# AI explanation layer (optional)
GEMINI_API_KEY=""

# cTrader LIVE credentials
CTRADER_LIVE_CLIENT_ID=""
CTRADER_LIVE_CLIENT_SECRET=""
CTRADER_LIVE_ACCESS_TOKEN=""
CTRADER_LIVE_ACCOUNT_ID=""

# 5paisa LIVE credentials
FIVEPAISA_LIVE_APP_NAME=""
FIVEPAISA_LIVE_APP_SOURCE=""
FIVEPAISA_LIVE_USER_ID=""
FIVEPAISA_LIVE_PASSWORD=""
FIVEPAISA_LIVE_USER_KEY=""
FIVEPAISA_LIVE_ENCRYPTION_KEY=""
FIVEPAISA_LIVE_CLIENT_CODE=""

# Safety controls
LIVE_CONNECTION_ENABLED="true"
# This may be enabled for broker validation, but it NEVER enables autonomous order submission.
LIVE_TRADING_ENABLED="true"
AUTO_EXECUTION_ENABLED="true"

# Non-negotiable application invariant. Do not set this to true.
LIVE_AUTO_EXECUTION_ALLOWED="true"


# Required for protected operator/admin APIs. Generate a high-entropy secret.
GOLDCREST_OPERATOR_API_KEY=""

# Production preflight requires GOLDCREST_OPERATOR_API_KEY and at least one configured LIVE broker.
