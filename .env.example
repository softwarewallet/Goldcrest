# Goldcrest runtime configuration
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3000"
TRUST_PROXY="false"

# Optional AI explanation layer
GEMINI_API_KEY=""

# cTrader Open API credentials and endpoint selection
# Settings can select LIVE or DEMO independently of Goldcrest's LIVE_ONLY application trading mode.
CTRADER_LIVE_API_HOST="auto"
CTRADER_DEMO_API_HOST="auto"
CTRADER_LIVE_CLIENT_ID=""
CTRADER_LIVE_CLIENT_SECRET=""
CTRADER_LIVE_ACCESS_TOKEN=""
CTRADER_LIVE_ACCOUNT_ID=""

# 5paisa LIVE credentials
FIVEPAISA_LIVE_APP_NAME=""
FIVEPAISA_LIVE_APP_SOURCE=""
FIVEPAISA_LIVE_USER_ID=""
FIVEPAISA_LIVE_PASSWORD=""
FIVEPAISA_LIVE_USER_KEY=""
FIVEPAISA_LIVE_ENCRYPTION_KEY=""
FIVEPAISA_LIVE_CLIENT_CODE=""
FIVEPAISA_LIVE_ACCESS_TOKEN=""
FIVEPAISA_LIVE_TOTP_SECRET=""
FIVEPAISA_LIVE_PIN=""

# Live connection / operator safety
LIVE_CONNECTION_ENABLED="true"
LIVE_TRADING_ENABLED="true"
GOLDCREST_OPERATOR_API_KEY=""

# Local development keeps the autonomous arm flags enabled so START AUTO LIVE
# can exercise the complete LIVE execution pipeline. Production safety gates still apply.
GOLDCREST_AUTO_TRADING_ENABLED="true"
GOLDCREST_AUTONOMOUS_LIVE_EXECUTION="true"
GOLDCREST_AUTO_TRADING_START_ON_BOOT="false"
GOLDCREST_AUTO_TRADING_INTERVAL_MS="60000"

# Live Forex market-news pipeline
# Finnhub: live market/Forex headlines
FINNHUB_API_KEY=""
FINNHUB_BASE_URL="https://finnhub.io/api/v1/news"

# Massive (Polygon.io): financial news with ticker metadata and publisher/source details
# Keep the API key in the deployment environment; do not commit a real key to this file.
MASSIVE_API_KEY=""
MASSIVE_BASE_URL="https://api.massive.com/v2/reference/news"
MASSIVE_MAX_ARTICLES="100"

# Currents News API: keyword/date search across a broad news source catalog
# Keep the API key in the deployment environment; do not commit a real key to this file.
CURRENTS_API_KEY=""
CURRENTS_BASE_URL="https://api.currentsapi.services/v2/search"
CURRENTS_PAGE_SIZE="20"

# Phase 1 historical Forex market-data persistence
# Initial backfill and recurring incremental refresh use the authoritative cTrader LIVE market-data adapter.
GOLDCREST_MARKET_HISTORY_DAILY_BARS="1000"
GOLDCREST_MARKET_HISTORY_WEEKLY_BARS="104"
GOLDCREST_MARKET_HISTORY_MONTHLY_BARS="24"
GOLDCREST_MARKET_HISTORY_INCREMENTAL_BARS="5"
GOLDCREST_MARKET_HISTORY_SYNC_INTERVAL_MS="1800000"
GOLDCREST_MARKET_HISTORY_PAIR_CONCURRENCY="2"

# Google News RSS: no API key; retained as backup/supplement when primary fresh coverage is thin
GOOGLE_NEWS_RSS_BASE_URL="https://news.google.com/rss/search"
GOOGLE_NEWS_RSS_MAX_QUERIES="2"
GOOGLE_NEWS_RSS_MIN_PRIMARY_ARTICLES="3"

GOLDCREST_NEWS_TIMEOUT_MS="10000"
GOLDCREST_NEWS_CACHE_TTL_MS="60000"
GOLDCREST_NEWS_FAILURE_BACKOFF_MS="180000"
GOLDCREST_NEWS_MAX_ARTICLE_AGE_MS="21600000"

# Indian market news intelligence (providers are server-gated to Indian market OPEN)
FMP_API_KEY=""
GOLDCREST_INDIA_PULSE_URL="https://pulse.zerodha.com/"
GOLDCREST_INDIA_CNBC_URL="https://www.cnbctv18.com/market/"
GOLDCREST_INDIA_ET_MARKETS_URL="https://economictimes.indiatimes.com/markets"
GOLDCREST_INDIA_MINT_URL="https://www.livemint.com/market"
GOLDCREST_INDIA_FMP_URL="https://financialmodelingprep.com/stable/news/stock-latest"
GOLDCREST_INDIA_NEWS_TIMEOUT_MS="8000"
GOLDCREST_INDIA_NEWS_CACHE_TTL_MS="60000"
GOLDCREST_INDIA_NEWS_MAX_ARTICLE_AGE_MS="21600000"

# Explicit production strategy approval.
# Current autonomous engine is the deterministic FX structure strategy.
GOLDCREST_PRODUCTION_STRATEGY_ID="fx_structure_v2a"
GOLDCREST_PRODUCTION_STRATEGY_APPROVED="true"

# Risk / trade sizing defaults are also configurable from the protected server config.
# Current application defaults: 1% risk/trade, 3% daily loss, 5 max positions, 20 trades/day,
# 3 consecutive losses, 30 bps max spread, $200 max Forex notional, ₹20,000 Indian notional.

# The legacy LIVE_AUTO_EXECUTION_ALLOWED flag is no longer used as a static .env switch.
# Do not add it to a real deployment.
